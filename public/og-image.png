<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <radialGradient id="bgGlow" cx="50%" cy="30%" r="60%">
      <stop offset="0%" stop-color="#14213d"/>
      <stop offset="100%" stop-color="#08080a"/>
    </radialGradient>
    <linearGradient id="textGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="50%" stop-color="#e0e7ff"/>
      <stop offset="100%" stop-color="#38bdf8"/>
    </linearGradient>
  </defs>
  
  <rect width="1200" height="630" fill="url(#bgGlow)"/>
  
  <!-- Subtle Grid -->
  <g opacity="0.08" stroke="#ffffff" stroke-width="1">
    <line x1="0" y1="100" x2="1200" y2="100"/>
    <line x1="0" y1="200" x2="1200" y2="200"/>
    <line x1="0" y1="300" x2="1200" y2="300"/>
    <line x1="0" y1="400" x2="1200" y2="400"/>
    <line x1="0" y1="500" x2="1200" y2="500"/>
    <line x1="200" y1="0" x2="200" y2="630"/>
    <line x1="400" y1="0" x2="400" y2="630"/>
    <line x1="600" y1="0" x2="600" y2="630"/>
    <line x1="800" y1="0" x2="800" y2="630"/>
    <line x1="1000" y1="0" x2="1000" y2="630"/>
  </g>

  <!-- Tag Pill -->
  <rect x="100" y="110" width="370" height="42" rx="21" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.1)"/>
  <circle cx="125" cy="131" r="5" fill="#2dd4bf"/>
  <text x="145" y="137" fill="#cbd5e1" font-family="monospace" font-size="16" letter-spacing="2">COMPUTER SCIENCE • AI/ML</text>

  <!-- Title -->
  <text x="100" y="240" fill="url(#textGrad)" font-family="system-ui, -apple-system, sans-serif" font-size="76" font-weight="800" letter-spacing="-1.5">Achint Jain</text>
  
  <!-- Subtitle -->
  <text x="100" y="320" fill="#94a3b8" font-family="system-ui, -apple-system, sans-serif" font-size="34" font-weight="500">I build intelligent products that solve real-world problems.</text>
  
  <!-- Description -->
  <text x="100" y="380" fill="#64748b" font-family="system-ui, -apple-system, sans-serif" font-size="22">Generative AI • RAG Pipelines • FastAPI • Next.js • Core Computer Science</text>

  <!-- Projects Badge -->
  <rect x="100" y="460" width="280" height="70" rx="14" fill="#0d0e14" stroke="rgba(255,255,255,0.1)"/>
  <text x="125" y="495" fill="#ffffff" font-family="system-ui, sans-serif" font-size="18" font-weight="600">QuickNotesLab AI</text>
  <text x="125" y="515" fill="#38bdf8" font-family="monospace" font-size="13">RAG • LangChain • Gemini</text>

  <rect x="400" y="460" width="280" height="70" rx="14" fill="#0d0e14" stroke="rgba(255,255,255,0.1)"/>
  <text x="425" y="495" fill="#ffffff" font-family="system-ui, sans-serif" font-size="18" font-weight="600">MaanVedh-AI</text>
  <text x="425" y="515" fill="#2dd4bf" font-family="monospace" font-size="13">BIS Standards • FastAPI</text>

  <!-- Location -->
  <text x="1100" y="560" fill="#64748b" font-family="monospace" font-size="16" text-anchor="end">Rajasthan, India</text>
</svg>
